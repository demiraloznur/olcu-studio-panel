@model List<CustomerSummary>
@{
    ViewData["Title"] = "Müşteriler";
}

<div class="sayfa-basi">
    <div>
        <h1>Müşteriler</h1>
        <p>@Model.Count müşteri</p>
    </div>
</div>

<section class="kart" aria-label="Müşteri listesi">
    @if (Model.Count == 0)
    {
        <p class="bos">Henüz müşteri yok.</p>
    }
    else
    {
        <div class="tablo-sar">
            <table class="tablo-kart">
                <thead>
                    <tr>
                        <th scope="col">Müşteri</th>
                        <th scope="col">Proje</th>
                        <th scope="col">Devam eden</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                <a class="proje-adi" href="/Home/Index?Search=@Uri.EscapeDataString(c.FullName)">@c.FullName</a>
                                <span class="alt-bilgi">@c.Email</span>
                            </td>
                            <td class="sayi" data-etiket="Proje">@c.ProjectCount</td>
                            <td class="sayi" data-etiket="Devam eden">@c.ActiveProjectCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
