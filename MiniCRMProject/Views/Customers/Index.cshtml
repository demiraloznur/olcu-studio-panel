@model List<CustomerSummary>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Müşteriler · ölçü studio</title>
</head>
<body>
    <main>
        <a href="/Home/Index">← Projeler</a>
        <h1>Müşteriler</h1>
        @if (Model.Count == 0)
        {
            <p>Henüz müşteri yok.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr><th scope="col">Müşteri</th><th scope="col">E-posta</th><th scope="col">Proje</th><th scope="col">Devam eden</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.FullName</td>
                            <td>@c.Email</td>
                            <td>@c.ProjectCount</td>
                            <td>@c.ActiveProjectCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </main>
</body>
</html>
