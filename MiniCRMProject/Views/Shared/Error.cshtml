@model ErrorViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Hata";
}

<h2>Bir şeyler ters gitti</h2>
<p class="aciklama">İsteğiniz işlenirken beklenmeyen bir hata oluştu. Lütfen biraz sonra tekrar deneyin.</p>
@if (Model?.ShowRequestId == true)
{
    <p class="alt-bilgi">İstek kimliği: <code>@Model.RequestId</code></p>
}
<a class="dugme" href="/Home/Index">Ana sayfaya dön</a>
