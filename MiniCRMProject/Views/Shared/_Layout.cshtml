@using MiniCRMProject.Security
@{
    var user = SessionUser.From(Context.Session);
    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string? Current(string name) => controller == name ? "page" : null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · ölçü studio</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="~/fonts/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="gizli" href="#icerik">İçeriğe geç</a>

    <header class="ust">
        <a class="marka" href="/Home/Index" aria-label="ölçü studio, projeler"><partial name="_Logo" /><span class="yazi">ölçü <span>studio</span></span></a>
        <button type="button" class="menu-dugme" aria-controls="yan-menu" aria-expanded="false">
            <span class="gizli">Menüyü aç</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
    </header>

    <div class="duzen">
        <nav class="yan" id="yan-menu" aria-label="Ana menü">
            <a class="marka" href="/Home/Index" aria-label="ölçü studio, projeler"><partial name="_Logo" /><span class="yazi">ölçü <span>studio</span></span></a>
            <ul class="menu">
                <li>
                    <a href="/Home/Index" aria-current="@Current("Home")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                        Projeler
                    </a>
                </li>
                @if (user?.IsAdmin == true)
                {
                    <li>
                        <a href="/Customers" aria-current="@Current("Customers")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="9" cy="8" r="4" /><path d="M2 21c0-4 3-6 7-6s7 2 7 6" /><path d="M16 4a4 4 0 0 1 0 8M22 21c0-3-1.5-5-4-5.7" /></svg>
                            Müşteriler
                        </a>
                    </li>
                    <li>
                        <a href="/Dashboard" aria-current="@Current("Dashboard")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></svg>
                            Özet
                        </a>
                    </li>
                }
            </ul>
            @if (user != null)
            {
                <div class="kullanici">
                    <strong>@user.FullName</strong>
                    <span>@(user.IsAdmin ? "Yönetici" : "Müşteri")</span>
                    <br />
                    <a href="/Account/Logout">Çıkış yap</a>
                </div>
            }
        </nav>

        <main class="icerik" id="icerik">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
