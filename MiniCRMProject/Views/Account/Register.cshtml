@model RegisterViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Müşteri Kaydı - NOVA Dijital Ajans</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="shortcut icon" href="https://cdn-icons-png.flaticon.com/512/2092/2092663.png?v=2" type="image/x-icon">
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/2092/2092663.png?v=2" type="image/x-icon">
    <style>
        body {
            background: linear-gradient(135deg, #1a103c 0%, #352168 100%);
            font-family: 'Inter', sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            color: white;
            overflow: hidden;
        }

        .auth-container {
            max-width: 1100px;
            width: 100%;
        }

        .glass-form {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px);
            border-radius: 25px;
            padding: 30px 40px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
            height: 480px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-label {
            font-size: 0.75rem;
            letter-spacing: 1px;
            color: #ffffff;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.9);
            border-radius: 10px;
            border: none;
            padding: 10px 12px;
            color: #1a103c;
        }

        .btn-neon {
            background: linear-gradient(to right, #8a2387, #e94057, #f27121);
            color: white;
            border: none;
            font-weight: 700;
            padding: 10px;
            border-radius: 10px;
            transition: 0.3s;
        }

            .btn-neon:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 20px rgba(233, 64, 87, 0.4);
                color: white;
            }

        .float-img {
            animation: float 8s ease-in-out infinite;
            width: 100%;
            height: 480px;
            object-fit: cover;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
        }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        h2 {
            font-size: 1.8rem;
        }
    </style>
</head>
<body>
    <div class="auth-container container">
        <div class="row align-items-center gx-5">
            <div class="col-md-6">
                <div class="glass-form">
                    <h2 class="fw-bold mb-1 text-center">Müşteri Başvurusu</h2>
                    <p class="text-center mb-3 opacity-75" style="font-size: 0.9rem;">Projelerinizi takip etmek için sisteme dahil olun.</p>
                    <form asp-action="Register" method="post" novalidate>
                        <div asp-validation-summary="All" class="text-warning small mb-2"></div>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label class="form-label">Adınız</label>
                                <input type="text" name="FirstName" value="@Model?.FirstName" class="form-control" required maxlength="50" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label">Soyadınız</label>
                                <input type="text" name="LastName" value="@Model?.LastName" class="form-control" required maxlength="50" />
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">E-Posta (Kurumsal)</label>
                            <input type="email" name="Email" value="@Model?.Email" class="form-control" required maxlength="100" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Şifre Belirleyin</label>
                            <input type="password" name="Password" class="form-control" required minlength="8" maxlength="100" />
                        </div>
                        <button type="submit" class="btn btn-neon w-100 mb-3">Kaydı Tamamla</button>
                        <div class="text-center">
                            <span class="opacity-75" style="font-size: 0.9rem;">Zaten kayıtlı mısınız?</span>
                            <a href="/Account/Login" class="text-decoration-none fw-bold" style="color: #f27121; font-size: 0.9rem;">Giriş Yapın</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-md-6 d-none d-md-block text-center">
                <img src="/images/register-3d.jpg" class="float-img" alt="Kayıt Görseli">
            </div>
        </div>
    </div>
</body>
</html>
