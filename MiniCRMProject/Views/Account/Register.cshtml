@model RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Kayıt";
}

<h2>Kayıt ol</h2>
<p class="aciklama">Hesabınız açıldıktan sonra stüdyo projenizi tanımladığında takip edebilirsiniz.</p>

<form asp-action="Register" method="post" novalidate>
    <div asp-validation-summary="All" class="hatalar" role="alert"></div>
    <div class="iki">
        <div class="alan">
            <label for="FirstName">Ad</label>
            <input type="text" id="FirstName" name="FirstName" value="@Model?.FirstName" autocomplete="given-name" required maxlength="50" />
        </div>
        <div class="alan">
            <label for="LastName">Soyad</label>
            <input type="text" id="LastName" name="LastName" value="@Model?.LastName" autocomplete="family-name" required maxlength="50" />
        </div>
    </div>
    <div class="alan">
        <label for="Email">E-posta</label>
        <input type="email" id="Email" name="Email" value="@Model?.Email" autocomplete="email" required maxlength="100" />
    </div>
    <div class="alan">
        <label for="Password">Şifre <span class="alt-bilgi">En az 8 karakter</span></label>
        <input type="password" id="Password" name="Password" autocomplete="new-password" required minlength="8" maxlength="100" />
    </div>
    <button type="submit" class="dugme tam">Kaydı tamamla</button>
    <p class="alt">Zaten hesabınız var mı? <a href="/Account/Login">Giriş yapın</a></p>
</form>
