@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Giriş";
}

<h2>Giriş yap</h2>
<p class="aciklama">Stüdyo ekibi ve müşterilerimiz için proje takip paneli.</p>

@if (ViewBag.Error != null)
{
    <p class="uyari" role="alert">@ViewBag.Error</p>
}

<form asp-action="Login" method="post">
    <div class="alan">
        <label for="email">E-posta</label>
        <input type="email" id="email" name="email" autocomplete="username" required />
    </div>
    <div class="alan">
        <label for="password">Şifre</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required />
    </div>
    <button type="submit" class="dugme tam">Giriş yap</button>
    <p class="alt">Hesabınız yok mu? <a href="/Account/Register">Kayıt olun</a></p>
</form>
