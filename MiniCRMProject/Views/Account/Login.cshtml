@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş - NOVA Dijital Ajans</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="shortcut icon" href="https://cdn-icons-png.flaticon.com/512/2092/2092663.png?v=2" type="image/x-icon">
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/2092/2092663.png?v=2" type="image/x-icon">
    <style>
        body {
            background: linear-gradient(135deg, #1a103c 0%, #352168 100%);
            font-family: 'Inter', sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            color: white;
            overflow: hidden;
        }

        .auth-container {
            max-width: 1100px;
            width: 100%;
        }

        .glass-form {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px);
            border-radius: 25px;
            padding: 40px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
            height: 480px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-label {
            font-size: 0.8rem;
            letter-spacing: 1px;
            color: #ffffff;
            font-weight: 700;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.9);
            border-radius: 12px;
            border: none;
            padding: 12px;
            color: #1a103c;
        }

        .btn-neon {
            background: linear-gradient(to right, #8a2387, #e94057, #f27121);
            color: white;
            border: none;
            font-weight: 700;
            padding: 12px;
            border-radius: 12px;
            transition: 0.3s;
        }

            .btn-neon:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 20px rgba(233, 64, 87, 0.4);
                color: white;
            }

        .float-img {
            animation: float 8s ease-in-out infinite;
            width: 100%;
            height: 480px;
            object-fit: cover;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
        }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }
    </style>
</head>
<body>
    <div class="auth-container container">
        <div class="row align-items-center gx-5">
            <div class="col-md-6 d-none d-md-block text-center">
                <img src="/images/login-3d.jpg" class="float-img" alt="Giriş Görseli">
            </div>

            <div class="col-md-6">
                <div class="glass-form">
                    <h2 class="fw-bold mb-1 text-center">NOVA CRM</h2>
                    <p class="text-center mb-4 opacity-75">Sisteme Giriş Yapın</p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger text-center py-2" style="border-radius: 12px;">@ViewBag.Error</div>
                    }

                    <form asp-action="Login" method="post">
                        <div class="mb-3">
                            <label class="form-label">E-Posta</label>
                            <input type="email" name="email" class="form-control" placeholder="ornek@firma.com" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Şifre</label>
                            <input type="password" name="password" class="form-control" placeholder="••••••••" required />
                        </div>
                        <button type="submit" class="btn btn-neon w-100 mb-4">Giriş Yap</button>
                        <div class="text-center">
                            <span class="opacity-75">Hesabınız yok mu?</span>
                            <a href="/Account/Register" class="text-decoration-none fw-bold" style="color: #f27121;">Kayıt Olun</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
