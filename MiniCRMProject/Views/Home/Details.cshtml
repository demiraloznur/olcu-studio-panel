@model ProjectModel
@{
    ViewData["Title"] = Model.ProjectName;
    var notes = (List<ProjectNote>)ViewBag.Notes;
    bool isAdmin = ViewBag.IsAdmin;
    int percent = Model.Stage.ProgressPercent();
}

<a class="geri" href="/Home/Index">← Projeler</a>
<div class="sayfa-basi">
    <div>
        <h1>@Model.ProjectName</h1>
        <p>@Model.Category.DisplayName()@(string.IsNullOrEmpty(Model.District) ? "" : " · " + Model.District)</p>
    </div>
    @if (isAdmin)
    {
        <a href="/Home/Edit/@Model.ProjectId" class="dugme ikincil">Düzenle</a>
    }
</div>

<div class="detay">
    <div>
        <section class="kart" aria-labelledby="asama-baslik">
            <h2 id="asama-baslik">Aşama: <span class="rozet asama-@((byte)Model.Stage)">@Model.Stage.DisplayName()</span></h2>
            <div class="ilerleme" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent" aria-label="Proje ilerlemesi">
                <span style="width: @(percent)%"></span>
            </div>
            <ol class="asamalar">
                @foreach (var stage in Enum.GetValues<ProjectStage>())
                {
                    <li class="@(stage <= Model.Stage ? "tamam" : null)" aria-current="@(stage == Model.Stage ? "step" : null)">@stage.DisplayName()</li>
                }
            </ol>
        </section>

        <section class="kart" aria-labelledby="not-baslik">
            <h2 id="not-baslik">İlerleme notları</h2>
            @if (isAdmin)
            {
                <form asp-action="AddNote" method="post" class="alan">
                    <input type="hidden" name="projectId" value="@Model.ProjectId" />
                    <label for="body">Yeni not</label>
                    <textarea id="body" name="body" rows="2" required maxlength="1000" placeholder="Konsept sunumu yapıldı"></textarea>
                    @if (TempData["NoteError"] is string noteError)
                    {
                        <p class="uyari" role="alert">@noteError</p>
                    }
                    <div><button type="submit" class="dugme">Notu ekle</button></div>
                </form>
            }
            @if (notes.Count == 0)
            {
                <p class="bos">Henüz not eklenmedi.</p>
            }
            else
            {
                <ul class="notlar">
                    @foreach (var note in notes)
                    {
                        <li>
                            <time datetime="@note.CreatedAt.ToString("yyyy-MM-dd")">@note.CreatedAt.ToString("dd.MM.yyyy")</time>
                            @note.Body
                        </li>
                    }
                </ul>
            }
        </section>
    </div>

    <aside class="kart" aria-label="Proje bilgileri">
        <h2>Bilgiler</h2>
        <dl class="bilgiler">
            <dt>Müşteri</dt>
            <dd>@Model.CustomerFullName</dd>
            <dt>Başlangıç</dt>
            <dd class="sayi">@Model.CreatedAt.ToString("dd.MM.yyyy")</dd>
            <dt>Tahmini bitiş</dt>
            <dd class="sayi">@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("dd.MM.yyyy") : "Belirlenmedi")</dd>
        </dl>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <h2 style="margin-top: 20px">Açıklama</h2>
            <p>@Model.Description</p>
        }
    </aside>
</div>
