@model ProjectModel
@{
    ViewData["Title"] = "Projeyi düzenle";
}

<a class="geri" href="/Home/Details/@Model.ProjectId">← @Model.ProjectName</a>
<div class="sayfa-basi">
    <h1>Projeyi düzenle</h1>
</div>

<form asp-action="Edit" method="post" class="kart">
    <partial name="_ProjectForm" model="Model" />
    <div class="form-alt">
        <button type="submit" class="dugme">Değişiklikleri kaydet</button>
        <a href="/Home/Details/@Model.ProjectId" class="dugme ikincil">Vazgeç</a>
    </div>
</form>
