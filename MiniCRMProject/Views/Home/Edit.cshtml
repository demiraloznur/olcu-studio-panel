@model MiniCRMProject.Models.ProjectModel
@{
    Layout = null;
    var role = ViewBag.UserRole;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Proje Düzenle - NOVA</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/2092/2092663.png" type="image/png">
    <link rel="shortcut icon" href="https://cdn-icons-png.flaticon.com/512/2092/2092663.png" type="image/png">

    <style>
        body {
            background: linear-gradient(135deg, #1a103c 0%, #352168 100%);
            font-family: 'Inter', sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            color: white;
            overflow: hidden;
        }

        .glass-form {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px);
            border-radius: 20px;
            padding: 35px 40px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
            max-width: 650px;
            width: 90%;
        }

        .form-label {
            font-size: 0.75rem;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.9);
            font-weight: 700;
            margin-bottom: 6px;
        }

        .form-control, .form-select {
            background-color: rgba(255, 255, 255, 0.95) !important;
            border-radius: 8px;
            border: none;
            padding: 10px 12px;
            color: #1a103c !important;
            font-size: 0.9rem;
        }

        .input-group-text {
            background-color: rgba(255, 255, 255, 0.8) !important;
            border: none;
            color: #888;
            font-size: 0.8rem;
            padding: 0 12px;
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        .form-control-lock {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            background-color: rgba(255, 255, 255, 0.8) !important;
        }

        .btn-neon {
            background: linear-gradient(to right, #8a2387, #e94057, #f27121);
            color: white !important;
            border: none;
            font-weight: 700;
            padding: 12px;
            border-radius: 8px;
            transition: 0.3s;
        }

            .btn-neon:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 15px rgba(233, 64, 87, 0.4);
            }
    </style>
</head>
<body>
    <div class="glass-form shadow-lg">
        <h3 class="fw-bold text-center mb-4">Proje Güncelle</h3>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-warning small mb-3"></div>
            <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
            <input type="hidden" name="CustomerId" value="@Model.CustomerId" />

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label text-uppercase">PROJE ADI</label>
                    <input type="text" name="ProjectName" class="form-control" value="@Model.ProjectName" required maxlength="150" />
                </div>
                <div class="col-md-6">
                    <label class="form-label text-uppercase">GÜNCEL DURUM</label>
                    <select name="Status" class="form-select">
                        <option value="Analiz Ediliyor" selected="@(Model.Status == "Analiz Ediliyor" ? "selected" : null)">Analiz Ediliyor</option>
                        <option value="Dokümantasyon" selected="@(Model.Status == "Dokümantasyon" ? "selected" : null)">Dokümantasyon</option>
                        <option value="Tasarımda" selected="@(Model.Status == "Tasarımda" ? "selected" : null)">Tasarımda</option>
                        <option value="Kodlanıyor" selected="@(Model.Status == "Kodlanıyor" ? "selected" : null)">Kodlanıyor</option>
                        <option value="Test Aşamasında" selected="@(Model.Status == "Test Aşamasında" ? "selected" : null)">Test Aşamasında</option>
                        <option value="Müşteri Onayında" selected="@(Model.Status == "Müşteri Onayında" ? "selected" : null)">Müşteri Onayında</option>
                        <option value="Yayında" selected="@(Model.Status == "Yayında" ? "selected" : null)">Yayında (Tamamlandı)</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label text-uppercase">AÇIKLAMA</label>
                <textarea name="Description" class="form-control" rows="2" maxlength="2000">@Model.Description</textarea>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="form-label text-uppercase">BAŞLANGIÇ TARİHİ</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                        <input type="text" class="form-control form-control-lock text-muted" value="@Model.CreatedAt.ToString("dd.MM.yyyy")" disabled />
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-uppercase">BİTİŞ TARİHİ</label>
                    @if (role == "Admin")
                    {
                        <input type="date" name="EndDate" class="form-control" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                    }
                    else
                    {
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input type="text" class="form-control form-control-lock text-muted" value="@(Model.EndDate.HasValue? Model.EndDate.Value.ToString("dd.MM.yyyy") : "Belirsiz")" disabled />
                        </div>
                        <input type="hidden" name="EndDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-neon w-100 mb-2">Değişiklikleri Kaydet</button>
            <div class="text-center mt-3">
                <a href="/Home/Index" class="text-white opacity-50 small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Vazgeç ve Geri Dön</a>
            </div>
        </form>
    </div>
</body>
</html>
