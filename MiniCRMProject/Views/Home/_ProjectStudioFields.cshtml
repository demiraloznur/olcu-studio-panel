@model ProjectModel
@* Proje ekleme ve düzenleme formlarında ortak: aşama, kategori, ilçe *@
<div class="row mb-3">
    <div class="col-md-4">
        <label class="form-label text-uppercase" for="Stage">Aşama</label>
        <select name="Stage" id="Stage" class="form-select">
            @foreach (var stage in Enum.GetValues<ProjectStage>())
            {
                <option value="@((byte)stage)" selected="@(Model?.Stage == stage ? "selected" : null)">@stage.DisplayName()</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label text-uppercase" for="Category">Kategori</label>
        <select name="Category" id="Category" class="form-select">
            @foreach (var category in Enum.GetValues<ProjectCategory>())
            {
                <option value="@((byte)category)" selected="@(Model?.Category == category ? "selected" : null)">@category.DisplayName()</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label text-uppercase" for="District">İlçe</label>
        <input type="text" name="District" id="District" class="form-control" value="@Model?.District" maxlength="50" placeholder="Nilüfer" />
    </div>
</div>
