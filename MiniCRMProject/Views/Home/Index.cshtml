@model List<ProjectModel>
@{
    ViewData["Title"] = "Projeler";
    var q = (ProjectListQuery)ViewBag.Query;
    bool isAdmin = ViewBag.UserRole == "Admin";
    DateTime today = DateTime.Today;
}

<div class="sayfa-basi">
    <div>
        <h1>Projeler</h1>
        <p>@(isAdmin ? "Stüdyonun tüm projeleri." : $"Hoş geldiniz, {ViewBag.UserFullName}. Projelerinizin durumu aşağıda.")</p>
    </div>
    @if (isAdmin)
    {
        <a href="/Home/Create" class="dugme">+ Yeni proje</a>
    }
</div>

@if (TempData["ErrorMessage"] is string error)
{
    <p class="uyari" role="alert">@error</p>
}

<form method="get" action="/Home/Index" class="kart filtre" role="search" aria-label="Projeleri filtrele">
    <div class="alan arama">
        <label for="Search">Ara</label>
        <input type="search" id="Search" name="Search" value="@q.Search" placeholder="Proje, müşteri ya da ilçe" />
    </div>
    <div class="alan">
        <label for="fCategory">Kategori</label>
        <select id="fCategory" name="Category">
            <option value="">Tümü</option>
            @foreach (var c in Enum.GetValues<ProjectCategory>())
            {
                <option value="@((byte)c)" selected="@(q.Category == c ? "selected" : null)">@c.DisplayName()</option>
            }
        </select>
    </div>
    <div class="alan">
        <label for="fStage">Aşama</label>
        <select id="fStage" name="Stage">
            <option value="">Tümü</option>
            @foreach (var st in Enum.GetValues<ProjectStage>())
            {
                <option value="@((byte)st)" selected="@(q.Stage == st ? "selected" : null)">@st.DisplayName()</option>
            }
        </select>
    </div>
    <div class="alan">
        <label for="fSort">Sırala</label>
        <select id="fSort" name="Sort">
            <option value="yeni" selected="@(q.Sort == "yeni" ? "selected" : null)">Yeniden eskiye</option>
            <option value="eski" selected="@(q.Sort == "eski" ? "selected" : null)">Eskiden yeniye</option>
            <option value="bitis" selected="@(q.Sort == "bitis" ? "selected" : null)">Bitiş tarihine göre</option>
        </select>
    </div>
    <div class="dugmeler">
        <button type="submit" class="dugme">Uygula</button>
        @if (q.HasFilter)
        {
            <a href="/Home/Index" class="dugme ikincil">Temizle</a>
        }
    </div>
</form>

<section class="kart" aria-label="Proje listesi">
    @if (Model.Count == 0)
    {
        <p class="bos">
            @if (q.HasFilter)
            {
                <text>Aramanıza uygun proje bulunamadı.</text>
            }
            else if (!isAdmin)
            {
                <text>Henüz size atanmış bir proje yok. Stüdyo projenizi oluşturduğunda burada görünecek.</text>
            }
            else
            {
                <text>Henüz proje yok. İlk projeyi eklemek için “Yeni proje”yi kullanın.</text>
            }
        </p>
    }
    else
    {
        <div class="tablo-sar">
            <table class="tablo-kart">
                <thead>
                    <tr>
                        <th scope="col">Proje</th>
                        @if (isAdmin)
                        {
                            <th scope="col">Müşteri</th>
                        }
                        <th scope="col">Aşama</th>
                        <th scope="col">Bitiş</th>
                        @if (isAdmin)
                        {
                            <th scope="col"><span class="gizli">İşlemler</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        bool late = item.EndDate.HasValue && item.EndDate.Value.Date < today && item.Stage != ProjectStage.TeslimEdildi;
                        <tr>
                            <td>
                                <a class="proje-adi" href="/Home/Details/@item.ProjectId">@item.ProjectName</a>
                                <span class="alt-bilgi">@item.Category.DisplayName()@(string.IsNullOrEmpty(item.District) ? "" : " · " + item.District)</span>
                            </td>
                            @if (isAdmin)
                            {
                                <td data-etiket="Müşteri">@item.CustomerFullName</td>
                            }
                            <td><span class="rozet asama-@((byte)item.Stage)">@item.Stage.DisplayName()</span></td>
                            <td class="sayi @(late ? "gecikti" : null)" data-etiket="Bitiş">
                                @(item.EndDate.HasValue ? item.EndDate.Value.ToString("dd.MM.yyyy") : "Belirlenmedi")
                                @if (late)
                                {
                                    <span class="gizli">(tarihi geçti)</span>
                                }
                            </td>
                            @if (isAdmin)
                            {
                                <td>
                                    <div class="islemler">
                                        <a class="ikon-dugme" href="/Home/Edit/@item.ProjectId" title="Düzenle" aria-label="@item.ProjectName projesini düzenle">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4z" /></svg>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.ProjectId" method="post" data-onay="@item.ProjectName projesi ve notları silinsin mi?">
                                            <button type="submit" class="ikon-dugme tehlike" title="Sil" aria-label="@item.ProjectName projesini sil">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" /></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
