@model MiniCRMProject.Models.ProjectModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yeni Proje - NOVA</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/2092/2092663.png" type="image/png">
    <link rel="shortcut icon" href="https://cdn-icons-png.flaticon.com/512/2092/2092663.png" type="image/png">

    <style>
        body {
            background: linear-gradient(135deg, #1a103c 0%, #352168 100%);
            font-family: 'Inter', sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            color: white;
            overflow: hidden;
        }

        .glass-form {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px);
            border-radius: 20px;
            padding: 35px 40px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
            max-width: 650px;
            width: 90%;
        }

        .form-label {
            font-size: 0.75rem;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.9);
            font-weight: 700;
            margin-bottom: 6px;
        }

        .form-control, .form-select {
            background-color: rgba(255, 255, 255, 0.95) !important;
            border-radius: 8px;
            border: none;
            padding: 10px 12px;
            color: #1a103c !important;
            font-size: 0.9rem;
        }

        .btn-neon {
            background: linear-gradient(to right, #8a2387, #e94057, #f27121);
            color: white !important;
            border: none;
            font-weight: 700;
            padding: 12px;
            border-radius: 8px;
            transition: 0.3s;
        }

            .btn-neon:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 15px rgba(233, 64, 87, 0.4);
            }
    </style>
</head>
<body>
    <div class="glass-form shadow-lg">
        <h3 class="fw-bold text-center mb-4">Yeni Proje Kaydı</h3>

        <form asp-action="Create" method="post">

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label text-uppercase">PROJE ADI</label>
                    <input type="text" name="ProjectName" class="form-control" placeholder="Projenin ismini girin..." required />
                </div>
                <div class="col-md-6">
                    <label class="form-label text-uppercase">MÜŞTERİ SEÇİMİ</label>
                    <select name="CustomerId" class="form-select" required>
                        <option value="">Seçiniz...</option>
                        @foreach (var customer in ViewBag.Customers)
                        {
                            <option value="@customer.UserId">@customer.FirstName @customer.LastName</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label text-uppercase">AÇIKLAMA</label>
                <textarea name="Description" class="form-control" rows="2" placeholder="Proje detaylarını yazın..."></textarea>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="form-label text-uppercase">GÜNCEL DURUM</label>
                    <select name="Status" class="form-select">
                        <option value="Analiz Ediliyor">Analiz Ediliyor</option>
                        <option value="Dokümantasyon">Dokümantasyon</option>
                        <option value="Tasarımda">Tasarımda</option>
                        <option value="Kodlanıyor">Kodlanıyor</option>
                        <option value="Test Aşamasında">Test Aşamasında</option>
                        <option value="Müşteri Onayında">Müşteri Onayında</option>
                        <option value="Yayında">Yayında (Tamamlandı)</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-uppercase">BİTİŞ TARİHİ</label>
                    <input type="date" name="EndDate" class="form-control" />
                </div>
            </div>

            <button type="submit" class="btn btn-neon w-100 mb-2">Sisteme Kaydet</button>
            <div class="text-center mt-3">
                <a href="/Home/Index" class="text-white opacity-50 small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Vazgeç ve Geri Dön</a>
            </div>
        </form>
    </div>
</body>
</html>
